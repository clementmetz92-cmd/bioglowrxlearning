# Netlify response headers. Versioned files (?v=… stamped by tools-bump-version.py) can be cached for a year.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://eu-assets.i.posthog.com https://tally.so; style-src 'self' 'unsafe-inline' https://tally.so; img-src 'self' data: blob: https://api.producthunt.com https://i.ytimg.com https://tally.so https://*.tally.so; font-src 'self' data: https://tally.so; connect-src 'self' https://eu.i.posthog.com https://eu-assets.i.posthog.com https://tally.so https://api.tally.so; frame-src https://www.youtube-nocookie.com https://tally.so; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
/engine/*
  Cache-Control: public, max-age=31536000, immutable
/data/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/manifest.webmanifest
  Content-Type: application/manifest+json
/sw.js
  Cache-Control: no-cache
